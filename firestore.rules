rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users Collection
    // Students can read/update their own profile; only admins can list all or edit roles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Subjects Collection
    // Any authenticated user can read; only admins can create, update, or delete
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Learning Materials Collection
    // Any authenticated user can read; only admins can create, update, or delete
    match /materials/{materialId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Quizzes Collection
    // Any authenticated user can read; only admins can create, update, or delete
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Quiz Results Collection
    // Students can create their own results and read their own results
    // Admins can read all results
    match /quizResults/{resultId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Progress Collection
    // Students can read and update their own progress; Admins can read all progress
    match /progress/{progressId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create, update: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Rewards Collection
    // Students can read their own rewards; Admins can read all rewards
    match /rewards/{rewardId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
